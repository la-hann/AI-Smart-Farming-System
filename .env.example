# Local MySQL settings (use these locally)
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=ai_smart_farming
COOKIE_SECURE=false
FLASK_DEBUG=false

# On Railway, add a MySQL service and use its MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD and MYSQLDATABASE variables. The app reads them automatically.
